# Copy to `.env` (same folder) and fill in values locally. `.env` is git-ignored.
# Backend reads KRT_* variables only. The browser NEVER receives any of these.
# Milestone 01 needs NONE of the keys below -- it runs entirely on synthetic fixtures.

# --- Runtime -------------------------------------------------------------------------
KRT_ENV=local
KRT_API_HOST=127.0.0.1          # must be loopback; startup fails otherwise
KRT_API_PORT=8000
KRT_CORS_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]
# KRT_DATABASE_URL=sqlite:///C:/path/to/krt.sqlite3   # default: backend/data/krt.sqlite3
KRT_QUOTE_MAX_AGE_SECONDS=60

# --- Market data source ----------------------------------------------------------------
# "fixture" = offline synthetic MOCK- markets; "kalshi_public" = Kalshi's public,
# unauthenticated market-data API (no key needed). This only sets the default for
# `python -m app.cli ingest`; the API server itself never fetches on its own.
KRT_MARKET_DATA_SOURCE=fixture
KRT_KALSHI_ENV=production         # production | demo
# Series to ingest (JSON list). Find tickers on kalshi.com market pages / series URLs.
KRT_KALSHI_SERIES_WATCHLIST=[]
KRT_KALSHI_MARKET_STATUS=open     # unopened | open | paused | closed | settled
KRT_KALSHI_ORDERBOOK_DEPTH=10     # 0 = all levels, max 100
KRT_KALSHI_MAX_PAGES=10
KRT_KALSHI_MIN_REQUEST_INTERVAL_SECONDS=0.25

# --- Signal engine (research only; never places orders) --------------------------------
KRT_SIGNAL_MODEL=gaussian_trailing          # gaussian_trailing | base_rate
KRT_SIGNAL_QUANTITY=10                      # contracts used for depth-aware VWAP
KRT_SIGNAL_SLIPPAGE_PER_CONTRACT=0.01
KRT_SIGNAL_MAX_SPREAD=0.10
KRT_SIGNAL_MIN_EDGE=0.02                    # lower-bound edge must exceed this
KRT_SIGNAL_MIN_HOLDOUT_EVENTS=60            # model must have >= this many holdout months
KRT_SIGNAL_MAX_MODEL_MARKET_DIVERGENCE=0.20
# Fee schedule verification lives in backend/app/signals/fee_schedules.json (see README).

# --- Paper trading (simulated; nothing is sent to any exchange) -------------------------
KRT_PAPER_STARTING_CASH=1000
KRT_PAPER_DEFAULT_SCENARIO=conservative     # conservative | baseline | harsh
KRT_PAPER_MAX_ORDER_QUANTITY=1000

# --- Approval-gated execution (MOCK / Kalshi DEMO only; production is not implemented) --
KRT_EXECUTION_ENABLED=false
KRT_EXECUTION_ENV=mock                      # mock | demo
# Created by: python -m app.cli set-approval-pin --write-env   (a salted hash, not the PIN)
KRT_EXECUTION_APPROVAL_PIN_HASH=
KRT_EXECUTION_MAX_CONTRACTS_PER_ORDER=10
KRT_EXECUTION_MAX_COST_PER_ORDER=25
KRT_EXECUTION_MAX_POSITION_CONTRACTS=50
KRT_EXECUTION_MAX_DAILY_COST=100
# Kalshi DEMO credentials only (demo.kalshi.co). Key file must live OUTSIDE this repo.
KRT_KALSHI_DEMO_API_KEY_ID=
KRT_KALSHI_DEMO_PRIVATE_KEY_PATH=

# --- Inefficiency scanner (suggestions only; YOU execute trades yourself) --------------
# Real-money experiment budget in dollars. Caps each idea: 20% (guaranteed combos) and
# 5% (conditional ideas). Leave empty until you decide.
KRT_EXPERIMENT_BUDGET_DOLLARS=
KRT_SCANNER_INTERVAL_SECONDS=300
KRT_SCANNER_MIN_PROFIT_DOLLARS=0.10
KRT_SCANNER_MAX_LEGS=8
KRT_ALERTS_DESKTOP=true

# --- Local worker (python -m app.worker) ----------------------------------------------
KRT_WORKER_KALSHI_INTERVAL_SECONDS=900      # only if KRT_MARKET_DATA_SOURCE=kalshi_public
KRT_WORKER_EVIDENCE_INTERVAL_SECONDS=21600  # 6 hours
KRT_WORKER_GAP_FACTOR=2.0                   # gap recorded if last success > interval x this

# --- Safety (fail closed) -------------------------------------------------------------
KRT_TRADING_MODE=paper          # only "paper" is accepted
KRT_LIVE_EXECUTION_ENABLED=false  # "true" refuses to start; no live code exists

# --- Kalshi PRODUCTION credentials: READ-ONLY account history (My trades page) ---------
# Optional. Used ONLY to read your fills, settlements, positions and balance. The client
# that uses them implements GET requests only, to a fixed list of history endpoints, and
# has no order code. Production order placement remains unimplemented.
# Create the key with READ scope if Kalshi offers the choice. Store the private key file
# OUTSIDE this repository (the app refuses paths inside it), e.g.
#   KRT_KALSHI_PRIVATE_KEY_PATH=C:\Users\you\.kalshi\krt-read.pem
KRT_KALSHI_API_KEY_ID=
KRT_KALSHI_PRIVATE_KEY_PATH=

# --- Games page: outside evidence for combo legs (read-only) --------------------------
# Box scores, schedules and injuries come from ESPN's public JSON (no key). Set false to
# stop the app from ever calling ESPN.
KRT_SPORTS_EVIDENCE_ENABLED=true
# Optional headline search inside a leg's research panel (https://brave.com/search/api/).
# Empty = off; the panel then shows search links instead. Sent only as a request header.
# Put the real value in .env (git-ignored), NOT in this file.
KRT_BRAVE_SEARCH_API_KEY=
# --- AI second opinion (Games slip) and Coach (My trades) ------------------------------
# Default: a LOCAL model through Ollama (free, private; the app only talks to loopback).
# Install Ollama, run `ollama pull gemma4:12b` (or any model), keep Ollama running.
# No API key is needed for Ollama.
KRT_LLM_PROVIDER=ollama
KRT_OLLAMA_BASE_URL=http://127.0.0.1:11434
KRT_OLLAMA_MODEL=gemma4:12b
KRT_OLLAMA_NUM_CTX=16384          # context window; the record is ~4k tokens
KRT_LLM_TIMEOUT_SECONDS=240
# Alternative (paid): KRT_LLM_PROVIDER=openai plus the key below. Empty = off. Each click is ONE paid
# OpenAI call; identical slips are cached for 15 minutes. What is sent: the slip's market
# names and prices, box-score stats, injuries and headlines. Never account data.
# Create a key at https://platform.openai.com/api-keys (set a monthly spend limit there).
KRT_OPENAI_API_KEY=
# Any chat model your key can use; change it if this one isn't available to you.
KRT_OPENAI_MODEL=gpt-4.1-mini
KRT_LLM_MAX_REVIEWS_PER_DAY=40
# --- Brave Search: one app-wide cap on requests ----------------------------------------
# The daily and monthly caps apply to the TOTAL of every Brave use in the app (Investigate,
# "Headlines here", AI-review headlines). Counted from this app's own ledger: NOT your Brave
# balance or bill (the app can't see those; check your Brave dashboard). Only explicit
# clicks spend requests; cached results are free. These defaults are also the maximums
# (800/month is about $4 at $5 per 1,000, below a $5 monthly credit). Lower them here.
KRT_RESEARCH_BRAVE_DAILY_REQUEST_CAP=60
KRT_RESEARCH_BRAVE_MONTHLY_REQUEST_CAP=800
KRT_RESEARCH_MAX_SEARCHES_PER_INVESTIGATION=5
KRT_RESEARCH_MAX_SOURCES_PER_INVESTIGATION=7
KRT_RESEARCH_SEARCH_CACHE_HOURS=6
# Data sources you want OFF (comma-separated ids from app/investigate/sources.py), e.g.
# moneypuck. This can only switch sources off; it never grants rights.
KRT_RESEARCH_DISABLED_SOURCES=
# --- Evidence sources (milestone 03+) -------------------------------------------------
# Registered source ids only (see backend/app/evidence/sources.py):
#   fred:CPIAUCSL (headline CPI), fred:CPILFESL (core CPI), fred:UNRATE (unemployment)
KRT_EVIDENCE_SOURCES=["fred:CPIAUCSL"]
# Get a free key at https://fred.stlouisfed.org/docs/api/api_key.html
# Put the real value in .env (git-ignored), NOT in this file.
KRT_FRED_API_KEY=
KRT_BLS_API_KEY=
KRT_BEA_API_KEY=
KRT_CENSUS_API_KEY=
KRT_NYT_API_KEY=
# SEC asks automated clients to identify themselves, e.g. "YourName your@email"
KRT_SEC_USER_AGENT=
